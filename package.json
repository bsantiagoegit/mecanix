    "@testing-library/user-event": "^14.6.7",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^28.1.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
